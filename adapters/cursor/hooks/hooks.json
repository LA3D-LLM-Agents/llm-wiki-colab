{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/ensure-wiki.sh\"" },
      { "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/session-start.sh\"" }
    ],
    "postToolUse": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/posttooluse.sh\"",
        "matcher": "Write|Edit"
      }
    ]
  }
}
