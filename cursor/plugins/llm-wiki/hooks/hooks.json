{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/cursor-session-start.sh\" \"${CURSOR_PLUGIN_ROOT}\""
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "matcher": "Shell",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/cursor-pre-tool-use.sh\" \"${CURSOR_PLUGIN_ROOT}\""
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "matcher": "Write|Edit",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/cursor-post-tool-use.sh\" \"${CURSOR_PLUGIN_ROOT}\""
      }
    ]
  }
}
